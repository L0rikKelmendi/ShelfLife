{
  "name": "shelflife",
  "version": "1.2.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/dm-serif-display": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^17.0.0",
    "expo": "~57.0.32",
    "expo-constants": "~57.0.22",
    "expo-dev-client": "~57.0.21",
    "expo-font": "~57.0.4",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.13",
    "expo-notifications": "~57.0.25",
    "expo-router": "~57.0.30",
    "expo-status-bar": "~57.0.1",
    "firebase": "^13.2.0",
    "lucide-react-native": "^1.68.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "scripts": {
    "start": "expo start --go",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "dev": "expo start --dev-client",
    "lint": "expo lint",
    "typecheck": "tsc --project jsconfig.json --noEmit",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:rules": "firebase emulators:exec --only firestore --project demo-shelflife \"node --test tests/firestore.rules.test.js\"",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-shelflife",
    "export:web": "expo export --platform web",
    "check": "npm run lint && npm run typecheck && npm test",
    "format": "prettier --write src tests scripts/*.cjs *.{js,json}",
    "test:cloud-rules": "node scripts/firebase-cloud-rules.cjs",
    "test:emulator-ui": "node scripts/run-emulator-browser-check.cjs"
  },
  "private": true,
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@testing-library/react-native": "13.3.3",
    "@types/react": "~19.2.4",
    "eslint": "9",
    "eslint-config-expo": "~57.0.2",
    "firebase-tools": "^15.34.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "prettier": "^3.9.10",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  }
}
