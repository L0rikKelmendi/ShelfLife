# Copy to .env.local and use the WEB app config from your own Firebase project.
# EXPO_PUBLIC values are bundled in the app; never put private keys here.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# OAuth client of type WEB, used to obtain the Firebase sign-in ID token.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Only needed when preparing an iPhone development build.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=

# Optional: Expo project's UUID after eas init.
EXPO_PUBLIC_EAS_PROJECT_ID=

# Local integration testing only. Real devices must use the computer's LAN IP.
EXPO_PUBLIC_USE_FIREBASE_EMULATORS=false
EXPO_PUBLIC_EMULATOR_HOST=127.0.0.1
